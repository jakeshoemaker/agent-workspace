# Machine-local files
.env
.env.*
!.env.example

# Secrets and SSH material (keep docs/placeholders)
secrets/**
!secrets/.gitkeep
!secrets/README.md
*.key
*.pem
id_rsa
id_ed25519
id_ecdsa
authorized_keys

# local/ machine-only (keep docs/placeholders)
local/**
!local/.gitkeep
!local/README.md

# Logs and temporary files
*.log
tmp/
.cache/

# OS/editor noise
.DS_Store
.vscode/
.idea/

# Python / uv
.venv/
__pycache__/
*.pyc

# Backup files from install-dotfiles
*.bak.*
