# Copy to ~/.ssh/config and edit. Do NOT commit the real file.
# chmod 600 ~/.ssh/config

Host *
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 6
  AddKeysToAgent yes
  # macOS only — remove on Linux clients if unsupported:
  # UseKeychain yes

# Example: reach the NUC over Tailscale
# Host nuc
#   HostName 100.x.y.z
#   User youruser
#   IdentityFile ~/.ssh/id_ed25519

# Example: LAN fallback (use only on trusted networks)
# Host nuc-lan
#   HostName 192.168.1.50
#   User youruser
#   IdentityFile ~/.ssh/id_ed25519
